# Server Port
PORT=5000

# Environment
NODE_ENV=development

# MongoDB Atlas URI (leave default or provide Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/city_discovery_india

# OpenAI API Key (optional for dynamic AI enrichment, falls back gracefully)
OPENAI_API_KEY=

# Client URL for CORS
CLIENT_URL=http://localhost:3000
